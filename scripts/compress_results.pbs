#!/bin/bash
# Pack a results directory into one archive, so it can be downloaded as a
# single file instead of many small files over the network filesystem.
# The archive is built on the node's local scratch disk and then copied back.
#
# Usage (from the project directory):
#   qsub -v SRC=results-mf-full scripts/compress_results.pbs
#
#PBS -N compress_results
#PBS -l select=1:ncpus=1:mem=2gb:scratch_local=8gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -eo pipefail

PROJECT_DIR="/storage/praha1/home/$USER/ags"

[[ -n "$SRC" ]] || { echo >&2 "FATAL: pass the directory to pack with -v SRC=<dir>"; exit 1; }
[[ -n "$SCRATCHDIR" ]] || { echo >&2 "FATAL: SCRATCHDIR is not set; submit with qsub"; exit 1; }
cd "$PROJECT_DIR"
[[ -d "$SRC" ]] || { echo >&2 "FATAL: $PROJECT_DIR/$SRC does not exist"; exit 1; }

ARCHIVE="$SRC.tar.gz"
echo "Packing $SRC on $(hostname) at $(date)"
tar -czf "$SCRATCHDIR/$ARCHIVE" "$SRC"
cp "$SCRATCHDIR/$ARCHIVE" "$PROJECT_DIR/$ARCHIVE.part"
mv "$PROJECT_DIR/$ARCHIVE.part" "$PROJECT_DIR/$ARCHIVE"
echo "Wrote $PROJECT_DIR/$ARCHIVE ($(stat -c %s "$ARCHIVE") bytes) at $(date)"
clean_scratch || true
